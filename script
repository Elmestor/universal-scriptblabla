-- Цикл для параметров движения (Speedhack, JumpPower, Noclip, Spin, Bhop, Fullbright, Hitboxes)
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    -- Спидхак
    if hum and Config.Speedhack then
        hum.WalkSpeed = Config.SpeedValue
    elseif hum and not Config.Speedhack then
        -- Не перебиваем стандартную, если отключено
    end

    -- Сила прыжка
    if hum and Config.JumpPowerToggle then
        hum.JumpPower = Config.JumpPowerValue
        hum.UseJumpPower = true
    end

    -- Ноуклип
    if char and Config.Noclip then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- БХоп (Авто-прыжок)
    if hum and Config.Bhop then
        if hum.MoveDirection.Magnitude > 0 and hrp and math.abs(hrp.Velocity.Y) < 0.1 then
            hum.Jump = true
        end
    end

    -- Спинбот (Вращение)
    if hrp and Config.Spin then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed / 10), 0)
    end

    -- Полное освещение
    if Config.Fullbright then
        game:GetService("Lighting").Ambient = Color3.fromRGB(255, 255, 255)
    end

    -- Увеличение Хитбоксов врагов
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local enemyHrp = player.Character.HumanoidRootPart
            if Config.HitboxToggle then
                enemyHrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                enemyHrp.Transparency = 0.7
                enemyHrp.Color = Color3.fromRGB(255, 0, 0)
                enemyHrp.CanCollide = false
            else
                enemyHrp.Size = Vector3.new(2, 2, 1)
                enemyHrp.Transparency = 1
            end
        end
    end
end)


-- ЛОГИКА РИСОВАНИЯ ESP (Box, Tracers, Names, Highlights)
local function CreateESP(player)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 0, 0)
    box.Thickness = 1
    box.Filled = false
    ESP_Boxes[player] = box

    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = Color3.fromRGB(0, 255, 0)
    line.Thickness = 1
    ESP_Lines[player] = line

    local text = Drawing.new("Text")
    text.Visible = false
    text.Color = Color3.fromRGB(255, 255, 255)
    text.Size = 16
    text.Center = true
    text.Outline = true
    ESP_Names[player] = text

    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if ESP_Highlight_Enabled and not char:FindFirstChild("ESPHighlight") then
            local hl = Instance.new("Highlight")
            hl.Name = "ESPHighlight"
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.Parent = char
        end
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateESP(p) end
end
Players.PlayerAdded:Connect(CreateESP)

Players.PlayerRemoving:Connect(function(player)
    if ESP_Boxes[player] then ESP_Boxes[player]:Remove() ESP_Boxes[player] = nil end
    if ESP_Lines[player] then ESP_Lines[player]:Remove() ESP_Lines[player] = nil end
    if ESP_Names[player] then ESP_Names[player]:Remove() ESP_Names[player] = nil end
end)

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera
    for player, box in pairs(ESP_Boxes) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        -- Управление подсветкой (Highlight) в реальном времени
        if char then
            local existingHl = char:FindFirstChild("ESPHighlight")
            if ESP_Highlight_Enabled and not existingHl then
                local hl = Instance.new("Highlight")
                hl.Name = "ESPHighlight"
                hl.FillColor = Color3.fromRGB(0, 170, 255)
                hl.Parent = char
            elseif not ESP_Highlight_Enabled and existingHl then
                existingHl:Destroy()
            end
        end

        if hrp and hum and hum.Health > 0 then
            local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                -- Логика Боксов
                if ESP_Box_Enabled then
                    local sizeX = camera.ViewportSize.X / pos.Z * 2
                    local sizeY = camera.ViewportSize.Y / pos.Z * 2
                    box.Size = Vector2.new(sizeX, sizeY)
                    box.Position = Vector2.new(pos.X - sizeX / 2, pos.Y - sizeY / 2)
                    box.Visible = true
                else
                    box.Visible = false
                end

                -- Логика Линий (Трейсеров)
                if ESP_Line_Enabled and ESP_Lines[player] then
                    ESP_Lines[player].From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    ESP_Lines[player].To = Vector2.new(pos.X, pos.Y)
                    ESP_Lines[player].Visible = true
                else
                    if ESP_Lines[player] then ESP_Lines[player].Visible = false end
                end

                -- Логика Имен
                if ESP_Name_Enabled and ESP_Names[player] then
                    ESP_Names[player].Position = Vector2.new(pos.X, pos.Y - (camera.ViewportSize.Y / pos.Z * 1.2))
                    ESP_Names[player].Text = player.Name
                    ESP_Names[player].Visible = true
                else
                    if ESP_Names[player] then ESP_Names[player].Visible = false end
                end
            else
                box.Visible = false
                if ESP_Lines[player] then ESP_Lines[player].Visible = false end
                if ESP_Names[player] then ESP_Names[player].Visible = false end
            end
        else
            box.Visible = false
            if ESP_Lines[player] then ESP_Lines[player].Visible = false end
            if ESP_Names[player] then ESP_Names[player].Visible = false end
        end
    end
end)
